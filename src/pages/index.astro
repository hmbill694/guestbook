---
import { actions, isInputError } from 'astro:actions';
import Layout from '../layouts/Layout.astro';
import { listMessages } from '../lib/db';

export const prerender = false;

const result = Astro.getActionResult(actions.addMessage);
if (result && !result.error) {
	return Astro.redirect('/#messages');
}

const fieldErrors = isInputError(result?.error) ? result.error.fields : {};
const messages = listMessages();
---

<Layout>
	<section id="about" class="card bg-base-100 shadow">
		<div class="card-body">
			<h2 class="card-title">Hi I'm Harrison. Here's a little about me.</h2>
			<p>
				I am a fun loving dude, who likes to build stuff. I consider myself to be the "5th man" on an engineering team.
				I'm open to going whereever the work is. I feel comfortable moving just about anywhere in the stack.
			</p>
			<p>
				I've lead development on frontends using React, Typescript, various styling and component frameworks. I feel
				comfortable working with product teams to get the feel just right.
			</p>
			<p>
				I've build backend services to power those frontends using languages like Java, Kotlin, Typescript (Node) and
				Rust (only in personal projects). I've stored data for these backends in both relational DBs like postgres and
				Sqlite and non-relational databases like Mongo and DynamoDB. I tend to favor just using Postgres or Sqlite
				though.
			</p>
			<p>
				I've stood up CI pipelines to automate deployment lots of the annoying parts of dev like releases, image
				construction, testing and build verification.
			</p>
			<p>
				I even feel comfortable at the infrastructure level. I've worked pretty deeply with Kubernetes and feel
				comfortable building helm charts and or working with kustomize when required. I've written a Kubernetes Operator
				before (a very small one) so I also feel comfortable developing against the infrastructure as well. I've used
				IAC tools like OpenTofu to create cloud resources in a nice way via GitOps. My hot take is the Kubernetes isn't
				as spooky as people make it out to be and can even be really easy to work with.
			</p>
			<p>
				See what I'm building on{' '}
				<a class="link" href="https://github.com/hmbill694">
					Github
				</a>{' '}
				and my{' '}
				<a class="link" href="https://www.linkedin.com/in/harrison-billings-9130a11b9/">
					LinkedIn
				</a>
			</p>
		</div>
	</section>

	<section id="leave-a-message" class="card bg-base-100 shadow">
		<form method="POST" action={actions.addMessage} class="card-body gap-4">
			<h2 class="card-title">Leave a Message</h2>

			{result?.error && !isInputError(result.error) && (
				<div role="alert" class="alert alert-error">
					Something went wrong. Please try again.
				</div>
			)}

			<label class="floating-label">
				<span>Name</span>
				<input
					type="text"
					name="name"
					placeholder="Name"
					maxlength="100"
					class:list={['input w-full', fieldErrors.name && 'input-error']}
					required
				/>
			</label>
			{fieldErrors.name && <p class="text-error text-sm">{fieldErrors.name.join(', ')}</p>}

			<label class="floating-label">
				<span>Message</span>
				<textarea
					name="message"
					placeholder="Message"
					maxlength="2000"
					class:list={['textarea h-32 w-full', fieldErrors.message && 'textarea-error']}
					required
				></textarea>
			</label>
			{fieldErrors.message && <p class="text-error text-sm">{fieldErrors.message.join(', ')}</p>}

			<div class="card-actions justify-end">
				<button type="submit" class="btn btn-primary">
					Sign the Guest Book
				</button>
			</div>
		</form>
	</section>

	<section id="messages" class="space-y-4">
		<h2 class="text-xl font-bold">Messages</h2>
		{messages.length === 0 ? (
			<p class="text-base-content/60">No messages yet. Be the first to sign!</p>
		) : (
			messages.map((m) => (
				<article class="card bg-base-100 shadow-sm">
					<div class="card-body">
						<div class="flex items-baseline justify-between gap-4">
							<h3 class="font-semibold">{m.name}</h3>
							<time class="text-base-content/60 text-sm" datetime={`${m.created_at}Z`}>
								{m.created_at} UTC
							</time>
						</div>
						<p class="whitespace-pre-line">{m.message}</p>
					</div>
				</article>
			))
		)}
	</section>
</Layout>
